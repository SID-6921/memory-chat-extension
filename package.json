{
  "name": "memory-chat-extension",
  "displayName": "Memory Chat Assistant",
  "description": "A VS Code sidebar chat with persistent transcript memory and workspace-aware answers.",
  "version": "0.0.1",
  "publisher": "local-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SID-6921/memory-chat-extension.git"
  },
  "bugs": {
    "url": "https://github.com/SID-6921/memory-chat-extension/issues"
  },
  "homepage": "https://github.com/SID-6921/memory-chat-extension#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:memoryChat.sidebar",
    "onCommand:memoryChat.ask",
    "onCommand:memoryChat.clearHistory",
    "onCommand:memoryChat.exportHistory"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memoryChat",
          "title": "Memory Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "memoryChat": [
        {
          "id": "memoryChat.sidebar",
          "name": "Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "memoryChat.ask",
        "title": "Memory Chat: Ask"
      },
      {
        "command": "memoryChat.clearHistory",
        "title": "Memory Chat: Clear Transcript"
      },
      {
        "command": "memoryChat.exportHistory",
        "title": "Memory Chat: Export Transcript"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "@vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3"
  }
}
